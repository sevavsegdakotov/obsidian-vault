# Absolute path to the Syncthing copy of your Obsidian vault on the VPS.
OBSIDIAN_VAULT_PATH=/srv/obsidian-vault

# New notes created by the MCP server go here. Existing notes can be updated anywhere in the vault.
OBSIDIAN_NEW_NOTE_FOLDER=Inbox

# IANA time zone used in generated note dates.
OBSIDIAN_TIME_ZONE=UTC
